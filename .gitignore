# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
.venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local provider credentials. Config stores environment-variable NAMES, never keys.
.env
.env.*
!.env.example

# OS noise
.DS_Store
Thumbs.db

# Training scratch inside checkpoints. NOT evidence: the Stage 2 lineage binds
# adapter_config.json and adapter_model.safetensors (see training-result.json
# final_adapter_file_sha256s and selection.json selected_adapter). Adam moment state is only
# useful for resuming an interrupted run, and at 465 MB per checkpoint it dominates repo size.
# `uv run sable-ir verify-audit-packet` passes without these.
**/checkpoints/*/optimizer.pt
**/checkpoints/*/rng_state.pth
**/checkpoints/*/scheduler.pt

# Superseded training checkpoints. The superseded-* directories exist to preserve the AUDIT TRAIL
# of invalidated runs -- their README, manifests, reports and JSON. The adapter weights of a run
# that was invalidated are not evidence anyone will re-derive anything from.
artifacts/pc-execution/superseded-*/**/checkpoints/

# Trained adapter weights. GitHub hard-rejects files over 100 MB and these are 233 MB each
# (931 MB total); Git LFS free quota is 1 GB, so neither path works. They stay on the run machine.
#
# CONSEQUENCE, stated plainly: selection.json and each eval manifest hash-bind
# adapter_model.safetensors, so `verify-audit-packet` will report selection_lineage and
# eval_lineage_* as failing on a fresh clone that lacks the weights. The recorded SHA-256 values
# remain in selection.json and training-result.json, so anyone holding the weights can still
# verify them. Every other check in the verifier passes from the repository alone.
**/checkpoints/*/adapter_model.safetensors

# NOTE: artifacts/ is deliberately NOT ignored. Run artifacts (manifests, results, reports,
# audits) are experimental evidence and are committed on purpose; an earlier transfer that
# relied on a plain git clone lost the Stage 0/1 artifacts and blocked Stage 2.
